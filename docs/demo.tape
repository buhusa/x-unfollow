Output docs/assets/demo.gif

Set Shell "zsh"
Set FontSize 16
Set Width 1100
Set Height 720
Set TypingSpeed 40ms
Set PlaybackSpeed 1
Set Theme { "name": "Whimsy", "background": "#171b24", "foreground": "#f5f7fb", "selection": "#36d6e7", "cursor": "#d946ef" }

Hide
Type "clear && X_UNFOLLOW_HOME=/tmp/x-unfollow-demo .venv/bin/x-unfollow"
Enter
Sleep 1s
Show
Sleep 2s

Type "2"
Sleep 1s
Type "u"
Enter
Sleep 2s
Enter
Sleep 2s

Enter
Sleep 2s
Enter
Sleep 2s

Hide
Type "q"
